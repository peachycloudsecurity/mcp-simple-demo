# MCP Configuration
MCP_SERVER_NAME=local-mcp-server
MCP_CLIENT_NAME=local-mcp-client

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
# Model options (all support tools):
# - llama3.2:1b (~1.3GB) - Best for low memory, supports tools
# - llama3.2:3b (~2.3GB) - Better quality, requires 3GB+ free RAM
# Note: tinyllama does NOT support tools, so use llama3.2:1b instead
OLLAMA_MODEL=llama3.2:1b

# Server Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000

# Logging
LOG_LEVEL=INFO

